<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Completion_Pct__c</fullName>
    <description>Calculated percent of the plan completed (paid quotas / total quotas).</description>
    <externalId>false</externalId>
    <formula>IF(Total_Quotas__c &gt; 0, (Paid_Quotas__c / Total_Quotas__c) * 100, 0)</formula>
    <inlineHelpText>Percent of the plan completed.</inlineHelpText>
    <label>Completion Pct</label>
    <precision>5</precision>
    <required>false</required>
    <scale>1</scale>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
