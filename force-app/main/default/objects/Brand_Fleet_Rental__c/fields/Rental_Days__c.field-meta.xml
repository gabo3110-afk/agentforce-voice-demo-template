    <formula>(DATEVALUE(End_Date__c) - DATEVALUE(Start_Date__c))</formula>
    <inlineHelpText>Total number of rental days.</inlineHelpText>
    <label>Rental Days</label>
    <precision>9</precision>
    <required>false</required>
    <scale>0</scale>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
