<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Days_Remaining__c</fullName>
    <description>Calculated days remaining before the warranty expires (0 if expired).</description>
    <externalId>false</externalId>
    <formula>IF(Expiry_Date__c &gt;= TODAY(), Expiry_Date__c - TODAY(), 0)</formula>
    <inlineHelpText>Days remaining on this warranty.</inlineHelpText>
    <label>Days Remaining</label>
    <precision>9</precision>
    <required>false</required>
    <scale>0</scale>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
