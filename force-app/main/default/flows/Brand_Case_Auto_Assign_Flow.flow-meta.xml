<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <description>Routes new Cases to the appropriate country queue (TASA for AR, TDB for BR) and seeds Protocol_Number__c if blank.</description>
    <environments>Default</environments>
    <interviewLabel>Brand Case Auto Assign {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Brand Case Auto Assign</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <runInMode>SystemModeWithSharing</runInMode>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Country_Decision</targetReference>
        </connector>
        <object>Case</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <decisions>
        <name>Country_Decision</name>
        <label>Country Decision</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <defaultConnector>
            <targetReference>Set_Protocol_If_Blank</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Other</defaultConnectorLabel>
        <rules>
            <name>Is_AR</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Country_Code__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>AR</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_TASA_Queue</targetReference>
            </connector>
            <label>Is AR</label>
        </rules>
        <rules>
            <name>Is_BR</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Country_Code__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>BR</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_TDB_Queue</targetReference>
            </connector>
            <label>Is BR</label>
        </rules>
    </decisions>
    <decisions>
        <name>Set_Protocol_If_Blank</name>
        <label>Set Protocol If Blank</label>
        <locationX>176</locationX>
        <locationY>480</locationY>
        <defaultConnectorLabel>End</defaultConnectorLabel>
        <rules>
            <name>Protocol_Is_Blank</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Protocol_Number__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Protocol_Value</targetReference>
            </connector>
            <label>Protocol Is Blank</label>
        </rules>
    </decisions>
    <recordLookups>
        <name>Get_TASA_Queue</name>
        <label>Get TASA Queue</label>
        <locationX>50</locationX>
        <locationY>240</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Assign_AR_Owner</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Region1_AfterSales_Queue</stringValue>
            </value>
        </filters>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Queue</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Group</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_TDB_Queue</name>
        <label>Get TDB Queue</label>
        <locationX>300</locationX>
        <locationY>240</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Assign_BR_Owner</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Region2_AfterSales_Queue</stringValue>
            </value>
        </filters>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Queue</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Group</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <assignments>
        <name>Assign_AR_Owner</name>
        <label>Assign AR Owner</label>
        <locationX>50</locationX>
        <locationY>360</locationY>
        <assignmentItems>
            <assignToReference>$Record.OwnerId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_TASA_Queue.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Set_Protocol_If_Blank</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_BR_Owner</name>
        <label>Assign BR Owner</label>
        <locationX>300</locationX>
        <locationY>360</locationY>
        <assignmentItems>
            <assignToReference>$Record.OwnerId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_TDB_Queue.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Set_Protocol_If_Blank</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Protocol_Value</name>
        <label>Set Protocol Value</label>
        <locationX>176</locationX>
        <locationY>600</locationY>
        <assignmentItems>
            <assignToReference>$Record.Protocol_Number__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Protocol_Formula</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <formulas>
        <name>Protocol_Formula</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Record.Id}, 3) + "-" + RIGHT({!$Record.CaseNumber}, 1)</expression>
    </formulas>
</Flow>
